# App (единый Docker-образ, Render)
PORT=8080

# Backend
BACKEND_PORT=8080
DB_PATH=/data/booking.db
APP_TIMEZONE=UTC

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_API_PROXY_STRIP_PREFIX=true

# E2E (Playwright)
PLAYWRIGHT_USE_SYSTEM_CHROME=0

# Render (деплой) — вставьте свой API-ключ
RENDER_API_KEY=rnd_place_your_key_here
